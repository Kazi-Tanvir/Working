# 1. Database (MySQL 8.0+ with Connection Pooling)
DATABASE_URL="mysql://user:password@host:4000/bd_fcommerce?sslaccept=strict&connection_limit=10"

# 2. Clerk Staff Authentication (Invite-Only Mode)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_key"
CLERK_SECRET_KEY="sk_test_your_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
CLERK_WEBHOOK_SECRET="whsec_your_secret"

# 3. Steadfast Courier Packzy API (Server-Only Secrets)
STEADFAST_API_KEY="your_steadfast_api_key"
STEADFAST_SECRET_KEY="your_steadfast_secret_key"
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"
STEADFAST_WEBHOOK_SECRET="your_webhook_bearer_secret"

# 4. Meta Pixel & Conversions API (CAPI)
NEXT_PUBLIC_META_PIXEL_ID="123456789012345"
META_CAPI_ACCESS_TOKEN="EAAB_your_capi_token"

# 5. Image Upload & Rate Limiting / Cron Security
UPLOADTHING_TOKEN="your_uploadthing_token"
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"
CRON_SECRET="random_32_char_secret_for_lead_cleanup"
