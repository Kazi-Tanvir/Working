// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  anime
  manga
  game
  movie
  series
}

enum MediaStatus {
  watching
  reading
  playing
  completed
  on_hold
  dropped
  plan_to_consume
}

enum ProgressUnit {
  ep
  ch
  hrs
  mins
}

model MediaEntry {
  id              String        @id @default(cuid())
  title           String        @db.VarChar(250)
  type            MediaType
  status          MediaStatus   @default(plan_to_consume)
  coverImage      String        @default("") @db.VarChar(500)
  releaseYear     Int           @default(2026)
  // MySQL stores string arrays as a native JSON array e.g. ["Action", "Drama"]
  genres          Json
  // Structured numeric rating (0.0 to 10.0, null if unrated / "N/A")
  rating          Float?
  // Structured numeric progress (replaces "18/28 EP" and "S1E06" regex parsing)
  progressCurrent Int           @default(0)
  progressTotal   Int?
  progressUnit    ProgressUnit  @default(ep)
  // Extended tracking metadata
  notes           String?       @db.Text
  isFavorite      Boolean       @default(false)
  rewatchCount    Int           @default(0)
  externalId      String?       @db.VarChar(100)
  externalSource  String?       @db.VarChar(30) // "anilist" | "tmdb" | "rawg" | "local"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([title, type])
  @@index([type])
  @@index([status])
  @@index([type, status])
  @@index([updatedAt])
  @@map("media_entries")
}
